{
  "name": "66ai-bot",
  "version": "0.2.13",
  "description": "66AI Bot: a team of long-lived Bots for DeepSeek Harness, with Main Bots, Bot-to-Bot messages and group chats",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "bot",
    "multi-agent",
    "agents"
  ],
  "homepage": "https://github.com/66ai-bot/66ai-bot#readme",
  "bugs": {
    "url": "https://github.com/66ai-bot/66ai-bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/66ai-bot/66ai-bot.git",
    "directory": "66ai-bot"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./web-search": "./web-search.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/host/",
    "src/shared/",
    "src/office/",
    "client.js",
    "office.js",
    "web-search.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --import ./test/harness-resolve.mjs --test \"test/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "harness": "npm install --prefix dev/harness --legacy-peer-deps=false --no-package-lock --no-fund --no-audit",
    "check": "sh dev/check.sh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-web": "*"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "deep-view": "0.1.0",
    "dingtalk-stream": "^2.1.6-beta.1",
    "undici": "^8.12.3"
  }
}
